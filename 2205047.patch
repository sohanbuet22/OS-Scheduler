@@ -0,0 +1,64 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+// Parse a possibly-large non-negative integer without relying on int-sized atoi,
+// so iteration counts in the billions work correctly (avoids the uint32 overflow
+// trap the spec warns about).
+uint64
+parse_u64(char *s)
+{
+  uint64 result = 0;
+  while(*s >= '0' && *s <= '9'){
+    result = result * 10 + (uint64)(*s - '0');
+    s++;
+  }
+  return result;
+}
+
+int
+main(int argc, char *argv[])
+{
+  if(argc != 3){
+    printf("Usage: dummyproc <tickets> <iterations>\n");
+    exit(1);
+  }
+
+  int tickets = (int)parse_u64(argv[1]);
+  uint64 iterations = parse_u64(argv[2]);
+
+  if(settickets(tickets) < 0){
+    printf("dummyproc: settickets failed, using default tickets\n");
+  }
+
+  int pid = fork();
+
+  if(pid < 0){
+    printf("dummyproc: fork failed\n");
+    exit(1);
+  }
+
+  if(pid == 0){
+    // Child: does similar dummy work, but sleeps periodically to
+    // simulate an I/O-bound process voluntarily giving up the CPU.
+    // This is what triggers PROMO events.
+    uint64 i;
+    for(i = 0; i < iterations; i++){
+      if(i > 0 && i % 50000000 == 0){
+        sleep(2);   // voluntary give-up -> triggers promotion in kernel sleep()
+      }
+      asm volatile("nop");
+    }
+    printf("dummyproc: child (pid %d) finished\n", getpid());
+    exit(0);
+  } else {
+    // Parent: pure CPU-bound dummy loop, no sleeping.
+    uint64 i;
+    for(i = 0; i < iterations; i++){
+      asm volatile("nop");
+    }
+    wait(0);
+    printf("dummyproc: parent (pid %d) finished\n", getpid());
+    exit(0);
+  }
+}
