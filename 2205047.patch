+// Called every timer tick, once per CPU, for whichever process THIS cpu is running.
+void
+update_time(void)
+{
+  struct proc *p = myproc();
+  if(p == 0)
+    return;
+
+  acquire(&p->lock);
+  if(p->state == RUNNING){
+    p->ticks_in_turn++;
+    p->queue_ticks[p->in_queue]++;
+    p->waiting_ticks = 0;                 // it's running, so it isn't "waiting"
+
+    int limit = (p->in_queue == 0) ? TIME_LIMIT_0 : TIME_LIMIT_1;
+    if(p->ticks_in_turn >= limit){
+      if(p->in_queue == 0){
+        if(print_logs)
+          printf("\x1b[33mDEMO: Process %d (%s) ran for %d time ticks, demoted to queue 1\x1b[0m\n",
+                 p->pid, p->name, p->ticks_in_turn);
+        p->in_queue = 1;
+      }
+      // if already in queue 1, there's nowhere lower — it just starts a fresh turn
+      p->ticks_in_turn = 0;
+    }
+  }
+  release(&p->lock);
+}
+
+// Called once per GLOBAL tick (guarded by caller to run on exactly one CPU),
+// increments wait time for everyone else and applies aging.
+void
+age_waiting_procs(void)
+{
+  struct proc *p;
+  for(p = proc; p < &proc[NPROC]; p++){
+    acquire(&p->lock);
+    if(p->state == RUNNABLE){
+      p->waiting_ticks++;
+      p->queue_ticks[p->in_queue]++;
+
+      if(p->in_queue == 1 && p->waiting_ticks >= WAIT_THRESH){
+        if(print_logs)
+          printf("\x1b[35mBOOST: Process %d (%s) waited for %d ticks, promoted to queue 0\x1b[0m\n",
+                 p->pid, p->name, p->waiting_ticks);
+        p->in_queue = 0;
+        p->waiting_ticks = 0;
+        p->ticks_in_turn = 0;
+      }
+    }
+    release(&p->lock);
   }
 }
 
